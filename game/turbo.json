{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "TEST_REDIS_URL",
    "JWT_*",
    "RECOVERY_CODE_*",
    "WS_*",
    "TRUST_PROXY",
    "HTTP_RATE_LIMIT_PER_MINUTE",
    "REDIS_COMMAND_TIMEOUT_MS",
    "LOG_LEVEL",
    "MATCH_*",
    "PORT",
    "PUBLIC_BASE_URL",
    "OPERATOR_*",
    "VITE_*",
    "E2E_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
