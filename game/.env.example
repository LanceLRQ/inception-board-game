# ============================================
# 盗梦都市 · 环境变量模板（开发与生产共用同一份 .env）
# ============================================
# 使用：
#   生产：./scripts/prod.sh init   （自动复制本文件为 .env，并生成下面三个必填密钥）
#   开发：cp .env.example .env     （开发只需要 DATABASE_URL / REDIS_URL 等，保持默认即可）
# .env 已被 git 忽略，不要提交。
# ============================================

# ---------- 数据库（生产） ----------
POSTGRES_DB=icgame
POSTGRES_USER=icgame
# 必填，留空由 ./scripts/prod.sh init 生成（只含字母数字，因为会被拼进连接地址）
POSTGRES_PASSWORD=

# ---------- Redis（生产） ----------
# 必填，留空由 ./scripts/prod.sh init 生成（只含字母数字，因为会被拼进连接地址）
# 这里存着进行中的对局，Redis 不设内存淘汰策略
REDIS_PASSWORD=

# ---------- 身份与跨域 ----------
# JWT 签名密钥：必填，留空由 ./scripts/prod.sh init 生成
JWT_SECRET=
JWT_EXPIRES_IN=30d

# 跨域白名单（接口请求与联机实时连接共用）：生产建议填域名（例 https://ico.example.com），开发用 *
WS_CORS_ORIGIN=*

# ---------- 对局节奏 ----------
# 毫秒，可不改：Bot 每步间隔 / 等待玩家应答的时限 / 一个回合的时限；超时由服务端代为行动
MATCH_BOT_STEP_DELAY_MS=600
MATCH_PENDING_TIMEOUT_MS=45000
MATCH_TURN_TIMEOUT_MS=120000

# ---------- 接口限流与日志 ----------
# 位于反向代理之后时设为 1，接口限流按真实来源地址（X-Forwarded-For）计数；
# 默认部署里后端端口只绑定本机，外部访问都经 nginx。若自行把后端端口对外开放，改为 0
TRUST_PROXY=1
# 同一来源地址每分钟的请求额度（好友房等待页每 3 秒轮询一次）
HTTP_RATE_LIMIT_PER_MINUTE=300
# 日志级别：trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# ---------- 端口（生产，宿主机侧） ----------
# 前端对外端口（对所有网卡开放，用户从这里进）
CLIENT_PORT=80
# 后端端口：只绑定 127.0.0.1，用于本机探活与排查
API_PORT=3001

# ---------- 镜像与仓库 ----------
# 镜像名为 <IMAGE_NAMESPACE>/icgame-api:<IMAGE_TAG> 与 <IMAGE_NAMESPACE>/icgame-client:<IMAGE_TAG>
IMAGE_NAMESPACE=icgame
IMAGE_TAG=latest
# 镜像仓库地址（例 registry.example.com）。留空表示只在本机构建使用，push / pull 不可用
IMAGE_REGISTRY=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ---------- 前端构建参数（构建 client 镜像时写入产物，修改后需重新构建） ----------
# 浏览器访问后端接口的前缀（默认同域，由 nginx 反代到 /api）
VITE_API_URL=/api
# 联机对局实时连接地址（默认同域，由 nginx 反代到 /ws；单独部署实时服务时填完整地址）
VITE_WS_URL=/ws

# ---------- 开发环境（./scripts/dev.sh） ----------
# 开发用的 Postgres / Redis 只绑定本机，端口与密码如下；密码仅限本机开发，可按需修改，
# 修改后下面两个连接地址要同步改
DEV_POSTGRES_PORT=15432
DEV_REDIS_PORT=16379
DEV_POSTGRES_PASSWORD=icgame_dev_only
DEV_REDIS_PASSWORD=icgame_dev_only
# dev.sh 会把这两项导出给 pnpm dev 启动的服务端（服务端运行时不读 .env 文件）
DATABASE_URL=postgresql://icgame:icgame_dev_only@127.0.0.1:15432/icgame
REDIS_URL=redis://:icgame_dev_only@127.0.0.1:16379
